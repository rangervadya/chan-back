# === Legacy GPU-образ: SAM-2 + FLUX.2 (требует NVIDIA GPU 12+ GB VRAM) ===
# Используйте его только при AI_BACKEND=legacy. Для бесплатного режима
# по умолчанию служит обычный Dockerfile (CPU-only, образ в разы меньше).

FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    python3-pip python3-dev git ca-certificates \
    libglib2.0-0 libsm6 libxext6 libxrender1 libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser

WORKDIR /app

# Install dependencies first (will be cached unless requirements change)
COPY requirements.ai.txt .
RUN pip3 install -r requirements.ai.txt --no-cache-dir

# Copy app last (frequently changed, invalidates cache only for final layer)
COPY app.py config.py logger.py ./
COPY recolor/ ./recolor/

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8001

CMD ["python3", "app.py"]
