# Корневой .env для docker-compose (подставляется в ${...} переменные).
# Скопируйте из .env.example в .env и заполните секреты.
# ВНИМАНИЕ: .env в .gitignore — секреты сюда НЕ коммитить.

# Режим логирования
LOG_MODE=prod
LOG_LEVEL=INFO

# ============================================================
#  Бэкенд анализа + перекраски изображения
# ============================================================
#   sam2-local — SAM 2.1 (point segmentation) + локальная перекраска (CPU, $0).
#                Требует requirements.sam2.txt и модель SAM 2.
#   local      — эвристическая сегментация без SAM 2 (CPU, $0, быстрее, менее точна).
#   cloudflare — Cloudflare Workers AI: 10 000 нейронов/день бесплатно,
#                реальный inpaint + vision-анализ. Требует ключи.
#   gemini     — Google Gemini (бесплатный тир) только анализирует объект,
#                перекраска локальная.
#   legacy     — СТАРЫЙ путь SAM-2 + FLUX.2 на GPU (дорого, 12+ GB VRAM).
#   auto       — cloudflare -> gemini -> sam2-local (по наличию ключей).
AI_BACKEND=sam2-local

# ------------------------------------------------------------
#  SAM 2 модель (только для AI_BACKEND=sam2-local)
#  Доступные варианты:
#    facebook/sam2.1-hiera-tiny      (~30M params, быстро на CPU)
#    facebook/sam2.1-hiera-small     (~80M params)
#    facebook/sam2.1-hiera-base-plus (~290M params, точнее)
# ------------------------------------------------------------
SAM2_MODEL_NAME=facebook/sam2.1-hiera-base-plus

# Офлайн-режим: если модель уже скачана в HF-кэш, можно отключить доступ к
# Hugging Face для ускорения старта (1=вкл, 0=выкл — позволяет скачать модель).
# По умолчанию выключен (0), чтобы при первом запуске модель скачалась из HF.
SAM2_LOCAL_FILES_ONLY=0

# Локальная директория с моделью SAM 2 (опционально).
# Если указана, берётся вместо SAM2_MODEL_NAME и автоматически включает
# SAM2_LOCAL_FILES_ONLY=1. Пример для сервера, где модель уже скачана:
#   SAM2_LOCAL_MODEL_PATH=/app/models/sam2.1-hiera-base-plus
#   SAM2_MODELS_DIR=/cham/models  (или ваш путь на хосте)
SAM2_LOCAL_MODEL_PATH=
# Хост-директория с моделями (монтируется в /app/models внутри контейнера)
SAM2_MODELS_DIR=

TORCH_NUM_THREADS=4

# ------------------------------------------------------------
#  Cloudflare Workers AI (бесплатный тир)
#  Account ID: dash.cloudflare.com -> Workers AI -> Use REST API
#  API Token : там же -> "Create a Workers AI API Token"
#  Права токена: Workers AI - Read + Workers AI - Edit
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_INPAINT_MODEL=@cf/runwayml/stable-diffusion-v1-5-inpainting
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------
#  Google Gemini (бесплатный тир — только анализ изображения)
#  Ключ: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Локальная сегментация ---
SEGMENT_MAX_SIZE=1024
MASK_FEATHER_PX=2.0

# --- Лимиты контейнера ---
SERVER_MEMORY_LIMIT=4G
SERVER_CPU_LIMIT=2.0

# --- API-ключи (обязательны для продакшена) ---
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=CHANGE_ME

# ============================================================
#  Только для AI_BACKEND=legacy (SAM-2 + FLUX.2 на GPU)
# ============================================================
HF_TOKEN=
