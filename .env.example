# Пример переменных окружения для AI-сервера.
# Скопируйте в server/.env и настройте под ваше окружение.
# Значения читаются в app.py / logger.py / config.py через os.getenv(...).

# Режим логирования: dev | prod
#   dev  — пишутся ВСЕ логи (DEBUG+), включая имена файлов, координаты,
#          параметры запросов. Удобно при локальной разработке/отладке.
#   prod — лишние логи отключены, уровень берётся из LOG_LEVEL (по умолчанию
#          WARNING), чтобы не светить чувствительные данные в продакшене.
LOG_MODE=dev

# Уровень логирования (используется в prod-режиме): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# API-ключи для доступа к серверу (через запятую).
# Клиент должен передавать один из них в заголовке X-API-Key.
# Если пусто — проверка ключа ОТКЛЮЧЕНА (только для локальной отладки!).
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=
